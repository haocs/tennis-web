# Replace OWNER/REPO with the real public package after its first release.
# Prefer the immutable digest printed in the GitHub release workflow summary.
TENNIS_IMAGE=ghcr.io/OWNER/REPO:0.1.0

# Actual NAS filesystem path to the shared published library. Never mount originals.
TENNIS_LIBRARY_PATH=/path/to/published/library
TENNIS_PORT=8765

# Numeric group ID with read/traverse permission on the shared library.
TENNIS_MEDIA_GID=100

# Optional compose.synology.yaml settings; use verified IDs, not guessed ones.
# TENNIS_APP_UID=NUMERIC_READER_UID
# TENNIS_APP_GID=NUMERIC_READER_GID
# TENNIS_DATA_PATH=/path/to/separate/native-host/website-state
